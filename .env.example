# =============================================================================
# LO FÁCIL: no copies este archivo a mano. Corre   python configurar.py
# y te arma el .env haciéndote dos preguntas.
#
# Esto es la referencia completa. El .env NO se sube al repositorio: acá viven
# las claves. Los datos públicos del negocio —nombre, colores, dirección,
# redes— NO van acá, van en flask_app/config/negocio.py.
#
# En Railway no se sube ningún .env: cada variable se escribe en la pestaña
# «Variables» del servicio. La base se enlaza con UNA sola línea:
#     MYSQL_URL=${{MySQL.MYSQL_URL}}
# =============================================================================

# --- Lo primero que hay que cambiar ------------------------------------------
# Firma la cookie de sesión Y los enlaces con token que van por correo. Con una
# clave conocida, cualquiera se fabrica una sesión de administrador: no hay que
# adivinar ninguna contraseña. En producción la app SE NIEGA A ARRANCAR si esta
# variable falta, es la de ejemplo o tiene menos de 32 caracteres.
#
# Genera una nueva para CADA instalación:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-algo-largo-y-aleatorio

# --- Producción --------------------------------------------------------------
# «production» apaga el modo depuración y hace que la cookie de sesión sea
# Secure (solo viaja por https). En tu máquina va vacío.
FLASK_ENV=
# 1 SOLO si hay un proxy adelante que reescribe las cabeceras X-Forwarded-*
# (Railway, Fly, Render, un nginx propio). En tu máquina va vacío: creerle a
# esas cabeceras sin proxy adelante deja que cualquiera diga de dónde viene.
DETRAS_DE_PROXY=

# --- Base de datos -----------------------------------------------------------
# En tu computador, una por dato:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tatuaje_db
# O todo en una (es lo que se usa en Railway). Si existe, manda sobre las de
# arriba:
# MYSQL_URL=mysql://usuario:clave@host:3306/base

# La app arma las tablas sola al arrancar (nunca borra nada). Para apagarlo:
# INSTALAR_AL_ARRANCAR=no
# Con «si», además carga el catálogo de ejemplo la primera vez:
# CARGAR_EJEMPLOS=si
# El primer administrador, creado al arrancar si ese correo todavía no existe.
# Útil en Railway; después de entrar, borra estas dos variables:
# ADMIN_CORREO=tu@correo.cl
# ADMIN_CLAVE=una-clave-larga-de-10-o-mas

# A dónde manda la raíz del sitio si algún día la portada se sirve aparte.
# Mientras esta app sirva también la landing, déjalo en /.
SITIO_PUBLICO=/

# --- Correo ------------------------------------------------------------------
# SIN SMTP_HOST la app NO manda nada: escribe cada correo como archivo en la
# carpeta buzon/ y deja el enlace en el log. Eso es lo que quieres mientras
# desarrollas. Con SMTP_HOST configurado, manda de verdad.
#
# OJO al poner esto en producción: en un servidor con disco efímero (Railway,
# Render) la carpeta buzon/ desaparece en cada despliegue. Si el negocio ya
# está recibiendo clientes y SMTP no está configurado, los correos de
# verificación y de recuperación de contraseña se pierden sin que nadie se
# entere. Configura SMTP ANTES de abrir el registro al público.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CORREO_DESDE=hola@tunegocio.cl
CORREO_NOMBRE=Insumos Tattoo Ejemplo
CORREO_BUZON=buzon

# --- Tienda (Shopify) --------------------------------------------------------
# OPCIONAL: solo si la tienda ya vende con Shopify. Sin SHOPIFY_DOMINIO, la
# sección «Tienda online», el carrito y sus pantallas del panel no aparecen, y
# el catálogo propio (el de /admin/carta) con los pedidos para retirar hacen
# ese trabajo.
#
# Cómo conseguir el token, una sola vez:
#   1. Admin de Shopify → Configuración → Aplicaciones y canales de venta →
#      Desarrollar aplicaciones → Crear una aplicación.
#   2. Ámbitos de la API de Storefront: con leer productos y colecciones basta
#      (unauthenticated_read_product_listings).
#   3. Instalar la aplicación y copiar el «token de acceso de la API de
#      Storefront». Es el PÚBLICO, no el de Admin.
#   4. Crear en Shopify la colección con los productos que van en el sitio. Su
#      handle es lo que va en SHOPIFY_COLECCION. Lo que esté en esa colección,
#      en ese orden, es lo que muestra el sitio.
SHOPIFY_DOMINIO=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_COLECCION=tienda-web
SHOPIFY_CACHE_SEGUNDOS=300

# El webhook de pedidos confirmados (/webhooks/shopify/orders-paid). Es OTRO
# secreto que el token de arriba, y sale de otra parte del admin de Shopify:
# Configuración → Notificaciones → Webhooks, al crear el de "Order payment"
# apuntando a https://tu-dominio/webhooks/shopify/orders-paid. Necesita el
# sitio ya desplegado, con URL pública — ver docs/TECNICO.md.
#
# Sin esto, el webhook contesta 401 a cualquiera y no guarda nada: mejor eso
# que aceptar un pedido que nadie pudo verificar que viene de verdad de
# Shopify.
SHOPIFY_WEBHOOK_SECRET=

# --- Datos del negocio (opcional acá) ----------------------------------------
# Todo esto vive en flask_app/config/negocio.py, que es donde conviene
# editarlo. Ponerlo acá sirve para dos casos: probar una instalación sin tocar
# el código, o servir dos negocios distintos desde el mismo repositorio.
# Cualquier variable de negocio.py se puede pisar acá con su nombre en
# MAYÚSCULAS.
#
# NEGOCIO_SLUG=principal
# MARCA_NOMBRE=Insumos Tattoo Ejemplo
# MARCA_PWA_NOMBRE=Ejemplo          # bajo el icono al instalarlo en el teléfono
# MARCA_CIUDAD=Tu Ciudad
# MARCA_GOOGLE_PLACE_ID=ChIJ...     # activa «Dejar una reseña» junto al mapa
# MARCA_GOOGLE_NOTA=4,9
# MARCA_GOOGLE_RESENAS=144
# MARCA_CORREO=hola@insumostattoo.cl
# MARCA_COLOR_ACENTO=#161616
# MARCA2_ACTIVA=no
# MARCA_RULETA_COLORES=#161616,#FFFFFF,#C8102E   # los gajos, en orden

# --- Más adelante ------------------------------------------------------------
# Pasarela de pago propia, cuando exista. El webhook de Shopify ya no va
# acá: se movió junto al resto de las variables de la tienda, más arriba.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
